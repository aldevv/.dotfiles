#!/usr/bin/env bash
# install-trays: set up the three tray icons on a GNOME or macOS machine that is not the
# relay box (titan runs its own from xmonad):
#   prs-status   speech bubble: THIS machine's open PRs/MRs (last commenter each), refreshed
#                every 15 min by a local job (systemd timer / launchd agent), list only
#   notify       dot: the relay box's linux-notify health + recent triggers, over SSH
#   claude-done  starburst: this machine's Claude "Done" notification toggle
#
# Usage: install-trays --relay-ssh "<ssh command to the relay box>" [--prs-env KEY=value]...
#   --prs-env is passed to prs-status, e.g. GH_HOST=<github host> or PRS_STATUS_FORGE=gitlab.
# Re-runnable: rewrites the autostart entries / units and restarts everything.
set -euo pipefail

RELAY_SSH="" PRS_ENV=()
while [ $# -gt 0 ]; do
  case $1 in
    --relay-ssh)
      RELAY_SSH=$2
      shift
      ;;
    --prs-env)
      PRS_ENV+=("$2")
      shift
      ;;
    *)
      echo "usage: install-trays --relay-ssh \"<ssh cmd>\" [--prs-env KEY=value]..." >&2
      exit 2
      ;;
  esac
  shift
done
[ -n "$RELAY_SSH" ] || {
  echo "install-trays: --relay-ssh is required" >&2
  exit 2
}

VENV="$HOME/.local/share/trays-venv"
NOTIFY_REPO="$HOME/repos/github.com/aldevv/my-notifications"
TRAYS_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ENGINE="$HOME/.dotfiles/general/marketplaces/auto-new-day/scripts"
IS_MAC=0
[ "$(uname)" = Darwin ] && IS_MAC=1

# Python env with pystray; on Linux it also sees the system gi bindings for the GTK backend.
if [ ! -x "$VENV/bin/python" ]; then
  if [ "$IS_MAC" = 1 ]; then python3 -m venv "$VENV"; else python3 -m venv --system-site-packages "$VENV"; fi
fi
"$VENV/bin/pip" install -q --upgrade pystray pillow
[ -d "$NOTIFY_REPO/.git" ] || git clone -q git@github.com:aldevv/my-notifications.git "$NOTIFY_REPO"

# $1=launchd label, $2=env KEY=value lines, $3=extra plist XML, rest=program args.
# Writes the LaunchAgent and (re)loads it; RunAtLoad starts it now and at every login.
launch_agent() {
  local label=$1 env_lines=$2 extra=$3
  shift 3
  local plist="$HOME/Library/LaunchAgents/$label.plist" args="" kv env_xml=""
  for a in "$@"; do args+="<string>$a</string>"; done
  while IFS= read -r kv; do
    [ -n "$kv" ] && env_xml+="<key>${kv%%=*}</key><string>${kv#*=}</string>"
  done <<<"$env_lines"
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array>$args</array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>$env_xml
  </dict>
  <key>RunAtLoad</key><true/>$extra
</dict></plist>
EOF
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  echo "started: $label"
}

# $1=name, $2=env KEY=value (or empty), rest=program args; GNOME autostart entry + start now.
# pystray picks AppIndicator on GNOME and dies without its typelib; GTK uses the legacy tray.
gnome_autostart() {
  local name=$1 kv=$2
  shift 2
  mkdir -p "$HOME/.config/autostart"
  cat >"$HOME/.config/autostart/tray-$name.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=tray-$name
Exec=env PYSTRAY_BACKEND=gtk${kv:+ \"$kv\"} $*
X-GNOME-Autostart-enabled=true
EOF
  pkill -f "^$1 $2" 2>/dev/null || true
  env PYSTRAY_BACKEND=gtk ${kv:+"$kv"} setsid -f "$@" >/dev/null 2>&1
  echo "started: tray-$name"
}

# Local refresh job: prs-status --baseline every 15 min on weekdays, 06:00 to 21:00.
prs_env_lines="$(printf '%s\n' "${PRS_ENV[@]+"${PRS_ENV[@]}"}")"
if [ "$IS_MAC" = 1 ]; then
  intervals=""
  for d in 1 2 3 4 5; do for h in $(seq 6 20); do for m in 0 15 30 45; do
    intervals+="<dict><key>Weekday</key><integer>$d</integer><key>Hour</key><integer>$h</integer><key>Minute</key><integer>$m</integer></dict>"
  done; done; done
  launch_agent com.kanon.prs-status "$prs_env_lines" "<key>StartCalendarInterval</key><array>$intervals</array>" \
    "$ENGINE/prs-status" --baseline
else
  mkdir -p "$HOME/.config/systemd/user"
  {
    printf '[Unit]\nDescription=prs-status: refresh the list of my open PRs\n\n[Service]\nType=oneshot\n'
    printf 'Environment=PATH=%s\n' "$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
    for kv in "${PRS_ENV[@]+"${PRS_ENV[@]}"}"; do printf 'Environment="%s"\n' "$kv"; done
    printf 'ExecStart=%s/prs-status --baseline\n' "$ENGINE"
  } >"$HOME/.config/systemd/user/prs-status.service"
  printf '[Unit]\nDescription=Refresh prs-status every 15 min on weekdays\n\n[Timer]\nOnCalendar=Mon..Fri *-*-* 06..20:00/15:00\nUnit=prs-status.service\n\n[Install]\nWantedBy=timers.target\n' \
    >"$HOME/.config/systemd/user/prs-status.timer"
  systemctl --user daemon-reload
  systemctl --user enable --now prs-status.timer
  systemctl --user start prs-status.service
  echo "started: prs-status.timer"
fi

if [ "$IS_MAC" = 1 ]; then
  launch_agent com.kanon.tray-prs-status "" "" "$VENV/bin/python" "$ENGINE/prs-status-tray"
  launch_agent com.kanon.tray-notify "NOTIFY_TRAY_SSH=$RELAY_SSH" "" "$VENV/bin/python" "$NOTIFY_REPO/notify-tray.py"
  launch_agent com.kanon.tray-claude-done "" "" "$VENV/bin/python" "$TRAYS_DIR/claude-done-tray"
else
  gnome_autostart prs-status "" "$VENV/bin/python" "$ENGINE/prs-status-tray"
  gnome_autostart notify "NOTIFY_TRAY_SSH=$RELAY_SSH" "$VENV/bin/python" "$NOTIFY_REPO/notify-tray.py"
  gnome_autostart claude-done "" "$VENV/bin/python" "$TRAYS_DIR/claude-done-tray"
fi
