#!/usr/bin/env bash
# install-trays: set up the three tray icons on a GNOME or macOS machine that is not
# the prs-status/relay box (titan runs them from xmonad instead):
#   prs-status   speech bubble: titan's prs-status timer toggle + last commenter per PR
#   notify       dot: titan's linux-notify relay health + recent triggers
#   claude-done  starburst: this machine's Claude "Done" notification toggle
#
# Usage: install-trays "<ssh command to titan>"
#   e.g. install-trays "ssh -o BatchMode=yes kanon@titan.local"
# Re-runnable: rewrites the autostart entries and restarts the three trays.
set -euo pipefail

TITAN_SSH=${1:?usage: install-trays \"<ssh command to titan>\"}
VENV="$HOME/.local/share/trays-venv"
NOTIFY_REPO="$HOME/repos/github.com/aldevv/my-notifications"
TRAYS_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
PRS_TRAY="$HOME/.dotfiles/general/marketplaces/auto-new-day/scripts/prs-status-tray"

# Python env with pystray; on Linux it also sees the system gi bindings for the GTK backend.
if [ ! -x "$VENV/bin/python" ]; then
  if [ "$(uname)" = Darwin ]; then python3 -m venv "$VENV"; else python3 -m venv --system-site-packages "$VENV"; fi
fi
"$VENV/bin/pip" install -q --upgrade pystray pillow

[ -d "$NOTIFY_REPO/.git" ] || git clone -q git@github.com:aldevv/my-notifications.git "$NOTIFY_REPO"

# $1=tray name; prints the KEY=value env the tray needs, or nothing.
tray_env() {
  case $1 in
    prs-status) echo "PRS_STATUS_SSH=$TITAN_SSH" ;;
    notify) echo "NOTIFY_TRAY_SSH=$TITAN_SSH" ;;
  esac
}
tray_script() {
  case $1 in
    prs-status) echo "$PRS_TRAY" ;;
    notify) echo "$NOTIFY_REPO/notify-tray.py" ;;
    claude-done) echo "$TRAYS_DIR/claude-done-tray" ;;
  esac
}

for name in prs-status notify claude-done; do
  script="$(tray_script "$name")"
  kv="$(tray_env "$name")"
  pkill -f "trays-venv/bin/python $script" 2>/dev/null || true

  if [ "$(uname)" = Darwin ]; then
    label="com.kanon.tray-$name"
    plist="$HOME/Library/LaunchAgents/$label.plist"
    env_xml=""
    [ -z "$kv" ] || env_xml="<key>${kv%%=*}</key><string>${kv#*=}</string>"
    # LaunchAgent so the tray starts at login; PATH covers ssh/jq from Homebrew.
    cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array><string>$VENV/bin/python</string><string>$script</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>$env_xml
  </dict>
  <key>RunAtLoad</key><true/>
</dict></plist>
EOF
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    echo "started: $label"
  else
    mkdir -p "$HOME/.config/autostart"
    cat >"$HOME/.config/autostart/tray-$name.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=tray-$name
Exec=env ${kv:+"$kv"} $VENV/bin/python $script
X-GNOME-Autostart-enabled=true
EOF
    env ${kv:+"$kv"} setsid -f "$VENV/bin/python" "$script" >/dev/null 2>&1
    echo "started: tray-$name"
  fi
done
