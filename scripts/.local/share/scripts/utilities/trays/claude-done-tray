#!/usr/bin/env python3
"""Tray icon for Claude Code "Done" notifications (the Stop hook in notify.sh): orange
starburst while they're on, grey while muted. Click or pick the menu item to toggle.
For trays that aren't xmobar (GNOME, macOS); xmobar uses the xpm icons instead.
"""
import math
import os
import subprocess
import time

from PIL import Image, ImageDraw

# pystray's Xorg backend still uses PIL.Image.ANTIALIAS, which Pillow 10 removed.
if not hasattr(Image, "ANTIALIAS"):
    Image.ANTIALIAS = Image.LANCZOS

import pystray

NOTIFY = os.path.expanduser("~/.claude/hooks/notify.sh")
MUTED = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "claude-notify/done-muted")
COLORS = {True: (217, 119, 87), False: (139, 148, 158)}


def is_on():
    return not os.path.exists(MUTED)


def make_star(rgb):
    img = Image.new("RGBA", (64, 64), (0, 0, 0, 0))
    draw = ImageDraw.Draw(img)
    for i in range(10):
        angle = math.radians(i * 36 - 90)
        reach = 30 if i % 2 == 0 else 25
        tip = (32 + reach * math.cos(angle), 32 + reach * math.sin(angle))
        draw.line([(32, 32), tip], fill=rgb, width=6)
        draw.ellipse((tip[0] - 3, tip[1] - 3, tip[0] + 3, tip[1] + 3), fill=rgb)
    draw.ellipse((24, 24, 40, 40), fill=rgb)
    return img


def toggle(icon, item):
    subprocess.run([NOTIFY, "toggle-done"], stdin=subprocess.DEVNULL)
    refresh(icon)


def quit_app(icon, item):
    # icon.stop() waits on poll()'s endless loop; os._exit skips that.
    os._exit(0)


def refresh(icon):
    on = is_on()
    icon.icon = make_star(COLORS[on])
    icon.title = f"Claude Done notifications {'on' if on else 'off'}"
    icon.menu = pystray.Menu(
        pystray.MenuItem(
            "Done notifications on (click to mute)" if on else "Done notifications off (click to unmute)",
            toggle,
            default=True,
        ),
        pystray.MenuItem("Quit", quit_app),
    )
    icon.update_menu()


def poll(icon):
    icon.visible = True
    last = None
    while True:
        if is_on() != last:
            refresh(icon)
            last = is_on()
        time.sleep(3)


if __name__ == "__main__":
    pystray.Icon("claude-done", make_star(COLORS[is_on()]), "Claude").run(setup=poll)
