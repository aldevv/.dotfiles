#!/usr/bin/env python3
"""Tray icon for prs-status: green speech bubble while the 15 min timer is on, grey when off.
Menu: turn the timer on/off, run a check now, open the log, and one row per open PR
with who commented last (click opens the PR).

PRS_STATUS_SSH="ssh <args> user@host" points it at the machine that runs the timer
(e.g. a laptop showing titan's); unset, it reads this machine.
"""
import json
import os
import shlex
import subprocess
import sys
import tempfile
import time
from datetime import datetime

from PIL import Image, ImageDraw

# pystray's Xorg backend still uses PIL.Image.ANTIALIAS, which Pillow 10 removed.
if not hasattr(Image, "ANTIALIAS"):
    Image.ANTIALIAS = Image.LANCZOS

import pystray

SSH = shlex.split(os.environ.get("PRS_STATUS_SSH", ""))
POLL_SECONDS = 30 if SSH else 10
COLORS = {True: (63, 185, 80), False: (139, 148, 158)}
OPENER = "open" if sys.platform == "darwin" else "xdg-open"

# Resolves the state dir on the machine that owns it, so the same snippet works locally and over SSH.
STATE_DIR = (
    'd=$(jq -r ".state_dir // empty" ~/.config/auto-new-day/profile.json 2>/dev/null); '
    'd=${AUTO_NEW_DAY_STATE_DIR:-${d:-$HOME/.local/state/auto-new-day}}; d=${d/#\\~/$HOME}; '
)
# The refresh job is a systemd timer on Linux and a launchd agent (com.kanon.prs-status) on macOS.
LAUNCHD = 'gui/$(id -u)/com.kanon.prs-status'
IS_ON = (
    "if command -v systemctl >/dev/null; then systemctl --user is-active --quiet prs-status.timer; "
    f"else launchctl print {LAUNCHD} >/dev/null 2>&1; fi"
)
STATE = STATE_DIR + (
    f"if {IS_ON}; then echo active; else echo inactive; fi; "
    'tail -n1 "$d/prs-status.log" 2>/dev/null || echo "no runs yet"; '
    'cat "$d/prs-status.json" 2>/dev/null || echo "{}"'
)


def sh(script):
    cmd = [*SSH, "bash -c " + shlex.quote(script)] if SSH else ["bash", "-c", script]
    return subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout


def read_state():
    try:
        active, last_line, cache = sh(STATE).split("\n", 2)
        prs = json.loads(cache).values()
    except (ValueError, subprocess.TimeoutExpired):
        return False, "cannot reach the prs-status machine", []
    prs = sorted(prs, key=lambda pr: pr.get("lastHumanAt") or "", reverse=True)
    return active == "active", last_line, prs


def notify(title, body):
    if sys.platform == "darwin":
        script = f"display notification {json.dumps(body)} with title {json.dumps(title)}"
        subprocess.run(["osascript", "-e", script])
    else:
        subprocess.run(["notify-send", title, body])


def local_time(iso):
    if not iso:
        return "no comments"
    return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone().strftime("%b %d %H:%M")


def pr_item(pr):
    who = pr.get("lastHumanBy") or "-"
    label = f"{pr['repo']}#{pr['number']}   {who}   {local_time(pr.get('lastHumanAt'))}"
    return pystray.MenuItem(label, lambda icon, item: subprocess.Popen([OPENER, pr["url"]]))


def toggle(icon, item):
    sh(
        "if command -v systemctl >/dev/null; then "
        "  if systemctl --user is-active --quiet prs-status.timer; "
        "  then systemctl --user disable --now prs-status.timer; "
        "  else systemctl --user enable --now prs-status.timer; fi; "
        f"elif launchctl print {LAUNCHD} >/dev/null 2>&1; then launchctl bootout {LAUNCHD}; "
        "else launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.kanon.prs-status.plist; fi"
    )
    refresh(icon)


def run_now(icon, item):
    sh(
        "if command -v systemctl >/dev/null; then systemctl --user start --no-block prs-status.service; "
        f"else launchctl kickstart {LAUNCHD}; fi"
    )
    notify("prs-status", "check started")


def open_log(icon, item):
    with tempfile.NamedTemporaryFile("w", suffix="-prs-status.log", delete=False) as log:
        log.write(sh(STATE_DIR + 'tail -n 200 "$d/prs-status.log"'))
    subprocess.Popen([OPENER, log.name])


def quit_app(icon, item):
    # icon.stop() waits on poll()'s endless loop; os._exit skips that.
    os._exit(0)


def menu_items(on, prs):
    yield pystray.MenuItem("Timer on (click to turn off)" if on else "Timer off (click to turn on)", toggle)
    yield pystray.MenuItem("Check now", run_now)
    yield pystray.MenuItem("Open log", open_log)
    yield pystray.Menu.SEPARATOR
    yield pystray.MenuItem("Last commenter per open PR:", None, enabled=False)
    for pr in prs:
        yield pr_item(pr)
    yield pystray.Menu.SEPARATOR
    yield pystray.MenuItem("Quit", quit_app)


def make_bubble(rgb):
    img = Image.new("RGBA", (64, 64), (0, 0, 0, 0))
    draw = ImageDraw.Draw(img)
    draw.rounded_rectangle((4, 6, 60, 46), radius=12, fill=rgb)
    draw.polygon([(14, 44), (14, 60), (30, 44)], fill=rgb)
    for x in (18, 32, 46):
        draw.ellipse((x - 5, 21, x + 5, 31), fill=(43, 46, 55))
    return img


def refresh(icon, state=None):
    on, last_line, prs = state or read_state()
    icon.icon = make_bubble(COLORS[on])
    icon.title = f"prs-status: timer {'on' if on else 'off'}\n{last_line}"
    icon.menu = pystray.Menu(*menu_items(on, prs))
    icon.update_menu()


def poll(icon):
    icon.visible = True
    last_seen = None
    while True:
        state = read_state()
        seen = (state[0], state[1], [(pr["url"], pr.get("lastHumanAt")) for pr in state[2]])
        if seen != last_seen:
            refresh(icon, state)
            last_seen = seen
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    tray = pystray.Icon("prs-status", make_bubble(COLORS[False]), "prs-status")
    tray.run(setup=poll)
